{
  "name": "server-session-manager",
  "productName": "Server Session Manager",
  "version": "0.5.0",
  "description": "Portable SSH / SFTP / FTP / RDP connection manager with embedded terminal, file browser and remote desktop",
  "main": "main.js",
  "author": "Ollie Davies",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:host": "%WINDIR%\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe /nologo /target:winexe /platform:anycpu /optimize+ /out:build\\rdp-host.exe /r:System.Windows.Forms.dll /r:System.Drawing.dll /r:Microsoft.CSharp.dll /r:System.Web.Extensions.dll build\\rdp-host\\Program.cs",
    "dist": "npm run build:host && electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "basic-ftp": "^5.0.5",
    "koffi": "^3.1.1",
    "ssh2": "^1.16.0"
  },
  "build": {
    "appId": "com.olliedavies.serversessionmanager",
    "productName": "Server Session Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "build/icon.ico",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "build/rdp-host.exe",
        "to": "rdp-host.exe"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Server-Session-Manager-${version}.exe"
    }
  }
}
