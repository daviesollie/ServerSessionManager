{
  "name": "server-session-manager",
  "productName": "Server Session Manager",
  "version": "1.3.5",
  "description": "Portable SSH / SFTP / FTP / RDP connection manager with embedded terminal, file browser and remote desktop",
  "main": "main.js",
  "author": "Peel",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "basic-ftp": "^5.0.5",
    "koffi": "^3.1.1",
    "ssh2": "^1.16.0"
  },
  "build": {
    "appId": "co.peel.serversessionmanager",
    "productName": "Server Session Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "build/icon.ico",
      "node_modules/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Server-Session-Manager-${version}.exe"
    }
  }
}
